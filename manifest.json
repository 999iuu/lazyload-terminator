{
  "manifest_version": 3,
  "name": "懒加载终结者",
  "version": "1.0.0",
  "description": "通用网页图片预加载：拦截 IntersectionObserver 让所有懒加载图片立即加载，无需滚动、无需手动刷新。支持按站点开关。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "懒加载终结者",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  }
}
