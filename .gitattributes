# 默认按文本处理，仓库内统一存 LF
* text=auto eol=lf

# 代码文件明确指定 LF
*.js    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary

# 中文（简体）
# 浏览器扩展商店的构建产物
dist/   export-ignore
build/  export-ignore
*.zip   export-ignore

# 缓存
.cache/ export-ignore
tmp/     export-ignore

# 系统
.DS_Store  export-ignore
Thumbs.db  export-ignore
